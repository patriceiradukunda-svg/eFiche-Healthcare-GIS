<?xml version="1.0" encoding="UTF-8"?>
<qgis projectname="eFiche Healthcare Market Intelligence System" version="3.32.0">
  <title>eFiche Healthcare Market Intelligence System</title>
  <author>eFiche GIS Team</author>
  <creation>2026-08-27T15:30:40.965580</creation>
  <abstract>Comprehensive healthcare facility database integrating eFiche clients and prospects with OpenStreetMap data for Rwanda</abstract>
  
  <!-- PROJECT PROPERTIES -->
  <properties>
    <Digitizing>
      <AvoidIntersections type="bool">true</AvoidIntersections>
    </Digitizing>
    <Gui>
      <CanvasColorRedPart type="int">255</CanvasColorRedPart>
      <CanvasColorGreenPart type="int">255</CanvasColorGreenPart>
      <CanvasColorBluePart type="int">255</CanvasColorBluePart>
    </Gui>
    <Legend>
      <filterByMap type="bool">false</filterByMap>
    </Legend>
    <Measure>
      <Ellipsoid type="QString">WGS84</Ellipsoid>
    </Measure>
    <Measurement>
      <AreaUnits type="QString">m2</AreaUnits>
      <DistanceUnits type="QString">meters</DistanceUnits>
    </Measurement>
    <PAL>
      <CandidatesPolygon type="int">0</CandidatesPolygon>
      <CandidatesLine type="int">0</CandidatesLine>
      <CandidatesPoint type="int">0</CandidatesPoint>
      <DrawRectOnly type="bool">false</DrawRectOnly>
      <ShowingCandidates type="bool">false</ShowingCandidates>
      <SearchMethod type="int">0</SearchMethod>
      <SpelloutNumberLabels type="bool">false</SpelloutNumberLabels>
    </PAL>
    <PositionPrecision>
      <DecimalPlaces type="int">2</DecimalPlaces>
      <DegreeFormat type="QString">DM</DegreeFormat>
      <Automatic type="bool">true</Automatic>
    </PositionPrecision>
  </properties>

  <!-- COORDINATE REFERENCE SYSTEM (WGS84) -->
  <spatialrefsys>
    <wkt>GEOGCS["WGS 84",DATUM["WGS_1984",SPHEROID["WGS 84",6378137,298.257223563,AUTHORITY["EPSG","7030"]],AUTHORITY["EPSG","6326"]],PRIMEM["Greenwich",0,AUTHORITY["EPSG","8901"]],UNIT["degree",0.0174532925199433,AUTHORITY["EPSG","9122"]],AUTHORITY["EPSG","4326"]]</wkt>
    <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
    <srsid>3452</srsid>
    <srid>4326</srid>
    <authid>EPSG:4326</authid>
    <description>WGS 84</description>
    <projectionacronym>longlat</projectionacronym>
    <ellipsoidacronym>WGS84</ellipsoidacronym>
    <geographicflag>true</geographicflag>
  </spatialrefsys>

  <!-- MAP EXTENT -->
  <mapcanvas>
    <units>degrees</units>
    <extent>
      <xmin>28.5</xmin>
      <ymin>-2.9</ymin>
      <xmax>30.9</xmax>
      <ymax>-0.9</ymax>
    </extent>
  </mapcanvas>

  <!-- LAYERS -->
  <layer-tree-group expanded="1" checked="Qt::Checked" name="eFiche Healthcare System">
    
    <!-- FACILITY LAYERS GROUP -->
    <layer-tree-group expanded="1" checked="Qt::Checked" name="Healthcare Facilities">
      
      <!-- HOSPITALS -->
      <layer-tree-layer expanded="0" checked="Qt::Checked" name="Hospitals" providerKey="ogr" source="./data/efiche_facilities.gpkg|layername=hospital" id="hospitals_layer">
        <customproperties/>
      </layer-tree-layer>

      <!-- HEALTH CENTRES -->
      <layer-tree-layer expanded="0" checked="Qt::Checked" name="Health Centres" providerKey="ogr" source="./data/efiche_facilities.gpkg|layername=health_centre" id="health_centres_layer">
        <customproperties/>
      </layer-tree-layer>

      <!-- HEALTH POSTS -->
      <layer-tree-layer expanded="1" checked="Qt::Checked" name="Health Posts" providerKey="ogr" source="./data/efiche_facilities.gpkg|layername=health_post" id="health_posts_layer">
        <customproperties/>
      </layer-tree-layer>

      <!-- CLINICS -->
      <layer-tree-layer expanded="0" checked="Qt::Checked" name="Clinics" providerKey="ogr" source="./data/efiche_facilities.gpkg|layername=clinic" id="clinics_layer">
        <customproperties/>
      </layer-tree-layer>

      <!-- PHARMACIES -->
      <layer-tree-layer expanded="0" checked="Qt::Checked" name="Pharmacies" providerKey="ogr" source="./data/efiche_facilities.gpkg|layername=pharmacy" id="pharmacies_layer">
        <customproperties/>
      </layer-tree-layer>

      <!-- LABORATORIES -->
      <layer-tree-layer expanded="0" checked="Qt::Checked" name="Laboratories" providerKey="ogr" source="./data/efiche_facilities.gpkg|layername=laboratory" id="laboratories_layer">
        <customproperties/>
      </layer-tree-layer>

    </layer-tree-group>

    <!-- REFERENCE LAYERS GROUP -->
    <layer-tree-group expanded="0" checked="Qt::Checked" name="Reference Data">
      <layer-tree-layer expanded="0" checked="Qt::Unchecked" name="All Facilities (Combined)" providerKey="ogr" source="./data/efiche_facilities.gpkg|layername=all_facilities" id="all_facilities_layer">
        <customproperties/>
      </layer-tree-layer>
    </layer-tree-group>

  </layer-tree-group>

  <!-- LAYER DEFINITIONS WITH STYLING -->
  
  <!-- HOSPITALS LAYER -->
  <maplayer minScale="0" maxScale="1e+08" type="vector" refreshOnNotifyEnabled="0" refreshOnNotifyMessage="" hasScaleBasedVisibilityFlag="0" styleCategories="AllStyleCategories" labelsEnabled="1">
    <extent>
      <xmin>29.7367</xmin>
      <ymin>-2.3872</ymin>
      <xmax>30.0600</xmax>
      <ymax>-1.9405</ymax>
    </extent>
    <id>hospitals_layer</id>
    <datasource>./data/efiche_facilities.gpkg|layername=hospital</datasource>
    <keywordList>
      <keyword>healthcare</keyword>
      <keyword>hospital</keyword>
      <keyword>Rwanda</keyword>
    </keywordList>
    <layername>Hospitals</layername>
    <srs>
      <spatialrefsys>
        <wkt>GEOGCS["WGS 84",DATUM["WGS_1984",SPHEROID["WGS 84",6378137,298.257223563,AUTHORITY["EPSG","7030"]],AUTHORITY["EPSG","6326"]],PRIMEM["Greenwich",0,AUTHORITY["EPSG","8901"]],UNIT["degree",0.0174532925199433,AUTHORITY["EPSG","9122"]],AUTHORITY["EPSG","4326"]]</wkt>
        <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
        <srsid>3452</srsid>
        <srid>4326</srid>
        <authid>EPSG:4326</authid>
        <description>WGS 84</description>
        <projectionacronym>longlat</projectionacronym>
        <ellipsoidacronym>WGS84</ellipsoidacronym>
        <geographicflag>true</geographicflag>
      </spatialrefsys>
    </srs>
    <resourceMetadata>
      <identifier></identifier>
      <parentidentifier></parentidentifier>
      <language></language>
      <type>dataset</type>
      <title>Hospitals in Rwanda</title>
      <abstract>Healthcare hospitals registered in eFiche system and identified through OpenStreetMap</abstract>
      <keywords vocabulary="gmd">healthcare;hospital;Rwanda</keywords>
      <contact><name></name><organization></organization><position></position><voice></voice><fax></fax><email></email><role></role></contact>
      <links/>
      <fees></fees>
      <constraints></constraints>
      <encoding></encoding>
      <crs>
        <spatialrefsys>
          <wkt>GEOGCS["WGS 84",DATUM["WGS_1984",SPHEROID["WGS 84",6378137,298.257223563,AUTHORITY["EPSG","7030"]],AUTHORITY["EPSG","6326"]],PRIMEM["Greenwich",0,AUTHORITY["EPSG","8901"]],UNIT["degree",0.0174532925199433,AUTHORITY["EPSG","9122"]],AUTHORITY["EPSG","4326"]]</wkt>
          <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
          <srsid>3452</srsid>
          <srid>4326</srid>
          <authid>EPSG:4326</authid>
          <description>WGS 84</description>
          <projectionacronym>longlat</projectionacronym>
          <ellipsoidacronym>WGS84</ellipsoidacronym>
          <geographicflag>true</geographicflag>
        </spatialrefsys>
      </crs>
      <spatialExtent/>
      <temporalExtent/>
    </resourceMetadata>
    <fieldConfiguration/>
    <aliases>
      <alias index="0" field="fid" name="FID"/>
      <alias index="1" field="facility_name" name="Facility Name"/>
      <alias index="2" field="facility_type" name="Type"/>
      <alias index="3" field="province" name="Province"/>
      <alias index="4" field="district" name="District"/>
      <alias index="5" field="sector" name="Sector"/>
      <alias index="6" field="cell" name="Cell"/>
      <alias index="7" field="village" name="Village"/>
      <alias index="8" field="latitude" name="Latitude"/>
      <alias index="9" field="longitude" name="Longitude"/>
      <alias index="10" field="phone" name="Phone"/>
      <alias index="11" field="email" name="Email"/>
      <alias index="12" field="website" name="Website"/>
      <alias index="13" field="opening_hours" name="Opening Hours"/>
      <alias index="14" field="address" name="Address"/>
      <alias index="15" field="client_status" name="Client Status"/>
      <alias index="16" field="source" name="Data Source"/>
      <alias index="17" field="data_quality" name="Data Quality"/>
      <alias index="18" field="verification_status" name="Verification Status"/>
    </aliases>
    <defaults/>
    <constraints/>
    <expressionfields/>
    <attributeactions>
      <action name="Show Details" icon="" catch_all="0" type="1" isEnabledOnlyWhenEditable="0">
        <actionname>Show Details</actionname>
      </action>
    </attributeactions>
    <conditionalstyles/>
    <storageType>GPKG</storageType>
    <GeometryCheckerPluginLayer/>
    <vectorJoins/>
    <layerGeometryType>0</layerGeometryType>
    <renderer-v2 type="categorizedSymbol" forceraster="0" symbollevels="0" attr="client_status" reorder_by_expression="0">
      <categories>
        <category value="eFiche Client" symbol="0" label="eFiche Client" render="true"/>
        <category value="Prospect" symbol="1" label="Prospect (Non-Client)" render="true"/>
      </categories>
      <symbols>
        <symbol name="0" type="marker" clip_to_extent="1">
          <layer locked="0" pass="0" class="SimpleMarker" enabled="1">
            <prop k="angle" v="0"/>
            <prop k="color" v="34,139,34,255"/>
            <prop k="horizontal_anchor_point" v="1"/>
            <prop k="joinstyle" v="bevel"/>
            <prop k="name" v="star"/>
            <prop k="offset" v="0,0"/>
            <prop k="offset_map_unit_scale" v="3x:0,0,0,0,0,0"/>
            <prop k="offset_unit" v="MM"/>
            <prop k="outline_color" v="0,0,0,255"/>
            <prop k="outline_style" v="solid"/>
            <prop k="outline_width" v="0.2"/>
            <prop k="outline_width_map_unit_scale" v="3x:0,0,0,0,0,0"/>
            <prop k="outline_width_unit" v="MM"/>
            <prop k="scale_method" v="diameter"/>
            <prop k="size" v="10"/>
            <prop k="size_map_unit_scale" v="3x:0,0,0,0,0,0"/>
            <prop k="size_unit" v="MM"/>
            <prop k="vertical_anchor_point" v="1"/>
          </layer>
        </symbol>
        <symbol name="1" type="marker" clip_to_extent="1">
          <layer locked="0" pass="0" class="SimpleMarker" enabled="1">
            <prop k="angle" v="0"/>
            <prop k="color" v="220,20,60,255"/>
            <prop k="horizontal_anchor_point" v="1"/>
            <prop k="joinstyle" v="bevel"/>
            <prop k="name" v="star"/>
            <prop k="offset" v="0,0"/>
            <prop k="offset_map_unit_scale" v="3x:0,0,0,0,0,0"/>
            <prop k="offset_unit" v="MM"/>
            <prop k="outline_color" v="0,0,0,255"/>
            <prop k="outline_style" v="solid"/>
            <prop k="outline_width" v="0.2"/>
            <prop k="outline_width_map_unit_scale" v="3x:0,0,0,0,0,0"/>
            <prop k="outline_width_unit" v="MM"/>
            <prop k="scale_method" v="diameter"/>
            <prop k="size" v="10"/>
            <prop k="size_map_unit_scale" v="3x:0,0,0,0,0,0"/>
            <prop k="size_unit" v="MM"/>
            <prop k="vertical_anchor_point" v="1"/>
          </layer>
        </symbol>
      </symbols>
    </renderer-v2>
    <labeling type="simple">
      <enabled>1</enabled>
      <palayer>1</palayer>
      <settings>
        <text isExpression="0" fieldName="facility_name"/>
        <name-style strikeout="0" underline="0" color="0,0,0,255" bold="1" italic="0"/>
        <size-style unit="MM" sizeType="0" size="2.5"/>
        <offset-style offsetUnits="MM" yOffset="2" xOffset="0"/>
        <shadow offsetUnit="MM" offsetAngle="135" blurRadius="0" offsetDistance="1" color="255,255,255,200" enabled="0"/>
        <dd_properties>
          <Option type="Map">
            <Option type="QString" key="name" value=""/>
          </Option>
        </dd_properties>
      </settings>
    </labeling>
  </maplayer>

  <!-- HEALTH POSTS LAYER (abbreviated for space) -->
  <maplayer minScale="0" maxScale="1e+08" type="vector" refreshOnNotifyEnabled="0" refreshOnNotifyMessage="" hasScaleBasedVisibilityFlag="0" styleCategories="AllStyleCategories" labelsEnabled="1">
    <id>health_posts_layer</id>
    <datasource>./data/efiche_facilities.gpkg|layername=health_post</datasource>
    <layername>Health Posts</layername>
    <srs>
      <spatialrefsys>
        <wkt>GEOGCS["WGS 84",DATUM["WGS_1984",SPHEROID["WGS 84",6378137,298.257223563,AUTHORITY["EPSG","7030"]],AUTHORITY["EPSG","6326"]],PRIMEM["Greenwich",0,AUTHORITY["EPSG","8901"]],UNIT["degree",0.0174532925199433,AUTHORITY["EPSG","9122"]],AUTHORITY["EPSG","4326"]]</wkt>
        <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
        <srsid>3452</srsid>
        <srid>4326</srid>
        <authid>EPSG:4326</authid>
      </spatialrefsys>
    </srs>
    <aliases>
      <alias index="0" field="fid" name="FID"/>
      <alias index="1" field="facility_name" name="Facility Name"/>
      <alias index="2" field="facility_type" name="Type"/>
      <alias index="3" field="province" name="Province"/>
      <alias index="4" field="district" name="District"/>
      <alias index="5" field="sector" name="Sector"/>
      <alias index="6" field="cell" name="Cell"/>
      <alias index="7" field="village" name="Village"/>
